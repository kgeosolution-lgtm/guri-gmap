<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <remove name="PythonCGI" />
      <remove name="Python CGI" />
      <add name="PythonCGI" path="*.py" verb="*" modules="CgiModule" scriptProcessor="D:\Program Files\ArcGIS\Pro\bin\Python\envs\arcgispro-py3\python.exe %s %s" resourceType="Either" requireAccess="Script" />
    </handlers>
    <cgi createCGIWithNewConsole="true" />
  </system.webServer>
</configuration>
