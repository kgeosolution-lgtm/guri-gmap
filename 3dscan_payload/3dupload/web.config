<?xml version="1.0" encoding="UTF-8"?>
<!--
  /app/3dupload/ : kgeoScan 업로드 CGI
  - *.py 를 Python CGI 로 실행. scriptProcessor 의 python.exe 경로는 서버에 맞게 바꾼다
    (arcpy 불필요. 3.11 이상이면 되고, 가상환경이면 그 Scripts\python.exe).
  - 업로드 한도 1 GB (Stray 녹화 1분 ≈ 170 MB). 요청 제한은 ASP.NET 과 IIS 양쪽 모두 올려야 한다.
  - common.py 는 직접 호출되지 않도록 막는다.
-->
<configuration>
  <system.web>
    <httpRuntime maxRequestLength="1048576" executionTimeout="600" />
  </system.web>
  <system.webServer>
    <handlers>
      <remove name="PythonCGI" />
      <add name="PythonCGI" path="*.py" verb="GET,POST" modules="CgiModule"
           scriptProcessor="D:\kgeoHub\tools\3dscan\venv\Scripts\python.exe -I %s %s"
           resourceType="File" requireAccess="Script" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
        <hiddenSegments>
          <add segment="common.py" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
