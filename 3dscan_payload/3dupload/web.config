<?xml version="1.0" encoding="UTF-8"?>
<!--
  /app/3dupload/ : kgeoScan 업로드 CGI
  - *.py 실행은 사이트(/app) 수준에 이미 있는 Python CGI 핸들러를 그대로 쓴다 (여기서 핸들러를 덮어쓰면 404.2 가 났다).
    CGI 3종은 표준 라이브러리만 쓰므로 어떤 Python 3 이든 된다. 워커/러너는 별도 venv(작업 스케줄러)에서 돈다.
  - 업로드 한도 1 GB (Stray 녹화 1분 ≈ 170 MB). 요청 제한은 ASP.NET 과 IIS 양쪽 모두 올린다.
  - common.py 는 직접 호출되지 않도록 막는다.
-->
<configuration>
  <system.web>
    <httpRuntime maxRequestLength="1048576" executionTimeout="600" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
        <hiddenSegments>
          <add segment="common.py" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
