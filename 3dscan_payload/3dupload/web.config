<?xml version="1.0" encoding="UTF-8"?>
<!--
  /app/3dupload/ : kgeoScan 업로드 CGI
  - 핸들러는 permit / permit_goyang 의 web.config 와 같은 정의를 쓴다 (서버에서 검증된 Python CGI 설정: ArcGIS Pro python, verb=*).
    CGI 3종은 표준 라이브러리만 쓰므로 Pro 의 Python 3.11 로 충분하다. 워커/러너는 별도 venv(작업 스케줄러)에서 돈다.
  - 업로드 한도 1 GB (Stray 녹화 1분 ≈ 170 MB). 요청 제한은 ASP.NET 과 IIS 양쪽 모두 올린다.
  - common.py 는 직접 호출되지 않도록 막고, 오류 응답의 JSON 본문은 IIS 오류 페이지로 바꾸지 않는다.
-->
<configuration>
  <system.web>
    <httpRuntime maxRequestLength="1048576" executionTimeout="600" />
  </system.web>
  <system.webServer>
    <handlers>
      <remove name="PythonCGI" />
      <remove name="Python CGI" />
      <add name="PythonCGI" path="*.py" verb="*" modules="CgiModule" scriptProcessor="C:\Program Files\Python314\python.exe %s %s" resourceType="Either" requireAccess="Script" />
    </handlers>
    <!-- false: CGI 마다 콘솔 창을 만들 필요가 없다 (true/false 모두 동작 확인, 2026-10-27).
         주의: 스크립트가 stderr 로 경고를 내면 IIS 가 그 줄을 응답 헤더에 섞어 HTTP/2 응답이 끊긴다 → 파이썬 경고가 없게 유지 -->
    <cgi createCGIWithNewConsole="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
        <hiddenSegments>
          <add segment="common.py" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
