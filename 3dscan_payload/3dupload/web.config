<?xml version="1.0" encoding="UTF-8"?>
<!--
  /app/3dupload/ : kgeoScan 업로드 CGI
  - *.py 실행은 사이트(/app) 수준에 이미 있는 Python CGI 핸들러를 그대로 쓴다 (여기서 핸들러를 덮어쓰면 404.2 가 났다).
    CGI 3종은 표준 라이브러리만 쓰므로 어떤 Python 3 이든 된다. 워커/러너는 별도 venv(작업 스케줄러)에서 돈다.
  - 업로드 한도 1 GB (Stray 녹화 1분 ≈ 170 MB). 요청 제한은 ASP.NET 과 IIS 양쪽 모두 올린다.
  - common.py 는 직접 호출되지 않도록 막는다.
-->
<configuration>
  <system.web>
    <httpRuntime maxRequestLength="1048576" executionTimeout="600" />
  </system.web>
  <system.webServer>
    <!-- 사이트 공통 .py 핸들러는 POST 를 받지 않아(405) 업로드 스크립트에만 POST 허용 핸들러를 둔다.
         scriptProcessor 는 배포가 CGI 허용 목록에 등록한 문자열과 정확히 같아야 한다. -->
    <handlers>
      <remove name="kgeoScanUploadCGI" />
      <add name="kgeoScanUploadCGI" path="upload.py" verb="GET,POST" modules="CgiModule"
           scriptProcessor="D:\kgeoHub\tools\3dscan\venv\Scripts\python.exe -I %s %s"
           resourceType="File" requireAccess="Script" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
        <hiddenSegments>
          <add segment="common.py" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
    <!-- 400/404/500 JSON 응답 본문을 IIS 오류 페이지로 바꾸지 않도록 -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
