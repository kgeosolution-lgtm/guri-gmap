<?xml version="1.0" encoding="UTF-8"?>
<!--
  D:\codesolution\kgeodata\3dscan\glb\web.config  (배포가 site/3dscan/glb.web.config 를 이 이름으로 복사)
  가우시안 스플랫 파일(.splat/.spz/.ksplat)과 뷰어 설정(.json), 정사영상 좌표 파일(.jgw/.prj)을 IIS 가 정적 파일로 내보내게 하는 MIME 매핑.
  이 폴더(glb\)에만 적용된다. remove 를 먼저 두어 상위 설정에 같은 확장자가 있어도 중복 오류(500.19)가 나지 않게 한다.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".splat" />
      <mimeMap fileExtension=".splat" mimeType="application/octet-stream" />
      <remove fileExtension=".spz" />
      <mimeMap fileExtension=".spz" mimeType="application/octet-stream" />
      <remove fileExtension=".ksplat" />
      <mimeMap fileExtension=".ksplat" mimeType="application/octet-stream" />
      <remove fileExtension=".ply" />
      <mimeMap fileExtension=".ply" mimeType="application/octet-stream" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".jgw" />
      <mimeMap fileExtension=".jgw" mimeType="text/plain" />
      <remove fileExtension=".prj" />
      <mimeMap fileExtension=".prj" mimeType="text/plain" />
      <remove fileExtension=".bin" />
      <mimeMap fileExtension=".bin" mimeType="application/octet-stream" />
    </staticContent>
  </system.webServer>
</configuration>
