<?xml version="1.0" encoding="UTF-8"?>
<!--
  D:\codesolution\kgeodata\3dscan\glb\web.config  (배포가 site/3dscan/glb.web.config 를 이 이름으로 복사)
  가우시안 스플랫 파일(.splat/.spz/.ksplat)과 뷰어 설정(.json), 정사영상 좌표 파일(.jgw/.prj)을 IIS 가 정적 파일로 내보내게 하는 MIME 매핑.
  이 폴더(glb\)에만 적용된다. remove 를 먼저 두어 상위 설정에 같은 확장자가 있어도 중복 오류(500.19)가 나지 않게 한다.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".splat" />
      <mimeMap fileExtension=".splat" mimeType="application/octet-stream" />
      <remove fileExtension=".spz" />
      <mimeMap fileExtension=".spz" mimeType="application/octet-stream" />
      <remove fileExtension=".ksplat" />
      <mimeMap fileExtension=".ksplat" mimeType="application/octet-stream" />
      <remove fileExtension=".ply" />
      <mimeMap fileExtension=".ply" mimeType="application/octet-stream" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".jgw" />
      <mimeMap fileExtension=".jgw" mimeType="text/plain" />
      <remove fileExtension=".prj" />
      <mimeMap fileExtension=".prj" mimeType="text/plain" />
      <remove fileExtension=".bin" />
      <mimeMap fileExtension=".bin" mimeType="application/octet-stream" />
      <remove fileExtension=".dxf" />
      <mimeMap fileExtension=".dxf" mimeType="application/dxf" />
      <!-- 굴착 기록 산출물 (<job>_util\ 하위 폴더에도 적용) -->
      <remove fileExtension=".geojson" />
      <mimeMap fileExtension=".geojson" mimeType="application/geo+json" />
      <remove fileExtension=".landxml" />
      <mimeMap fileExtension=".landxml" mimeType="application/xml" />
      <remove fileExtension=".csv" />
      <mimeMap fileExtension=".csv" mimeType="text/csv" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <!-- 2026-11-16: 3D·사진 파일은 6시간 묻지 않고 쓴다 (상위 3dscan\web.config 의 no-cache 를 덮어씀).
           설명 JSON(tour.json·meta.json·.splat.json)은 페이지가 늘 cache:no-store 로 받으므로 고친 내용이 바로 보인다 -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.06:00:00" />
    </staticContent>
  </system.webServer>
</configuration>
