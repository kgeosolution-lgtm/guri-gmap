<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer>
<defaultDocument><files><clear/><add value="index.html"/></files></defaultDocument>
<directoryBrowse enabled="false"/>
<httpErrors existingResponse="PassThrough"/>
<handlers><remove name="PythonCGI"/><remove name="Python CGI"/><add name="PythonCGI" path="api.py" verb="GET,POST" modules="CgiModule" scriptProcessor="C:\Program Files\ArcGIS\Pro\bin\Python\envs\arcgispro-py3\python.exe %s %s" resourceType="File" requireAccess="Script"/></handlers>
<cgi createCGIWithNewConsole="true"/>
<security><requestFiltering><requestLimits maxAllowedContentLength="54525952"/></requestFiltering></security>
<staticContent><remove fileExtension=".json"/><mimeMap fileExtension=".json" mimeType="application/json"/><remove fileExtension=".svg"/><mimeMap fileExtension=".svg" mimeType="image/svg+xml"/><clientCache cacheControlMode="DisableCache"/></staticContent>
<httpProtocol><customHeaders><remove name="X-Powered-By"/><remove name="X-Content-Type-Options"/><add name="X-Content-Type-Options" value="nosniff"/><remove name="Referrer-Policy"/><add name="Referrer-Policy" value="no-referrer"/><remove name="X-Robots-Tag"/><add name="X-Robots-Tag" value="noindex,nofollow"/><remove name="Content-Security-Policy"/><add name="Content-Security-Policy" value="default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"/></customHeaders></httpProtocol>
</system.webServer></configuration>
